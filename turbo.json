{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "TELEPHONY_DRIVER",
    "MESSAGING_DRIVER",
    "STT_DRIVER",
    "TTS_DRIVER",
    "LLM_DRIVER",
    "CRM_DRIVER",
    "STORAGE_DRIVER",
    "ANTHROPIC_API_KEY",
    "BITRIX_WEBHOOK_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] },
    "generate": { "cache": false }
  }
}
