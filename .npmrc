# Hoist Prisma + Nest decorators reliably across the workspace
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
link-workspace-packages=true
prefer-workspace-packages=true

# @hire-stella/ui is a private package on GitHub Packages. The auth token is NOT set here
# (pnpm never expands env vars in a committed .npmrc): see DEPLOY.md, "Private UI package".
@hire-stella:registry=https://npm.pkg.github.com
