// SuperDemo — multi-tenant contact centre schema.
//
// Tenancy: every tenant-owned row carries `orgId`. It is NOT a foreign key on
// the leaf tables (only User and Setting relate to Organization) — 20-odd FKs to
// one table buys referential integrity we don't need, because orgs are
// deactivated rather than deleted, and costs a constrained write on every insert
// in the call path. Isolation is enforced in one place instead: the tenant
// Prisma extension in packages/db/src/tenant.ts injects `orgId` into every
// where-clause and every create. See that file for what it does and does not
// cover.
//
// `orgId String @default("")` rather than a required field: the default keeps it
// optional in Prisma's generated create inputs, so the extension can supply it
// at runtime without 50 call sites having to name it. A row that somehow escapes
// the extension gets "" — which matches no organisation, so it is invisible
// rather than visible to everyone. Fail closed.
//
// Design notes worth defending in review:
//  * CallParticipant, not Call.agentId — the AI→human handoff IS the product,
//    so the schema represents both legs. Multi-party conference comes free.
//  * Conversation sits above Call — WhatsApp and web chat are new `channel`
//    values with zero migration. That is what "unified dashboard" means.
//  * AgentStateEvent is append-only — occupancy and adherence reports are
//    unreliable if derived from mutable current-state rows.
//  * OutboxEvent — Bitrix will be down sometimes. The outbox makes "recorded
//    locally but missing in CRM" impossible rather than merely unlikely.
//  * providerCallId is unique — carriers and simulators both redeliver events.
//    Idempotency is enforced by the database, not by application `if`s.
//
// embedding is Float[] rather than pgvector: the local Postgres is vendored via
// `embedded-postgres` (no extension build toolchain). At a few hundred FIT
// course chunks, in-process cosine is sub-millisecond. See NOT-IMPLEMENTED.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ============================== enums ==================================== */

enum Role {
  AGENT
  SUPERVISOR
  ADMIN
  /// Platform operator, above any single contact centre. Belongs to no org
  /// (User.orgId is null) and is the only role that can create them.
  SUPERADMIN
}

enum Location {
  DUBAI
  INDIA
  EGYPT
}

enum Skill {
  MANAGEMENT
  EDUCATION
  FINANCE
  LANGUAGE
  GENERAL
}

enum AgentStatus {
  AVAILABLE
  ON_CALL
  WRAPUP
  BUSY
  BREAK
  OFFLINE
}

enum Channel {
  VOICE
  WHATSAPP
  WEBCHAT
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum ConversationStatus {
  ACTIVE
  WAITING
  CLOSED
}

enum CallState {
  RINGING
  AI_HANDLING
  ESCALATING
  QUEUED
  AGENT_RINGING
  AGENT_TALKING
  WRAPUP
  COMPLETED
}

enum ParticipantKind {
  CALLER
  AI_AGENT
  HUMAN_AGENT
}

enum MessageRole {
  CALLER
  AI
  HUMAN_AGENT
  SYSTEM
}

enum EscalationReason {
  CALLER_REQUESTED
  LOW_CONFIDENCE
  OUT_OF_SCOPE
  NEGATIVE_SENTIMENT
  MAX_TURNS
  HUMAN_ONLY_INTENT
}

enum HangupCause {
  CALLER_HANGUP
  AGENT_HANGUP
  AI_RESOLVED
  ABANDONED_IN_QUEUE
  NO_AGENT_AVAILABLE
  SYSTEM_ERROR
}

enum Disposition {
  LEAD_QUALIFIED
  ENROLMENT_INTEREST
  INFO_PROVIDED
  CALLBACK_REQUESTED
  FEE_ENQUIRY
  EXISTING_STUDENT_SUPPORT
  NOT_INTERESTED
  WRONG_NUMBER
  SPAM
}

enum RoutingStrategy {
  LONGEST_IDLE
  ROUND_ROBIN
  SKILL_WEIGHTED
}

enum SyncDirection {
  OUTBOUND_TO_BITRIX
  INBOUND_FROM_BITRIX
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum TargetStatus {
  PENDING
  /// Claimed by the dialer; a call is being placed or is live.
  CALLING
  ANSWERED
  NO_ANSWER
  /// Attempts exhausted without an answer.
  EXHAUSTED
  FAILED
  /// Never call: the contact asked not to be, or has no consent basis.
  SUPPRESSED
}

enum NumberStatus {
  AVAILABLE
  ASSIGNED
  RELEASED
}

/* ============================ organisations =============================== */

/// A tenant — one contact centre. Everything a client's staff can see hangs off
/// this row. Deactivated, never deleted: their calls and recordings stay
/// attributable, exactly as for a departed agent.
/// What kind of business a tenant is. Drives what gets provisioned at
/// onboarding and how routing categories are labelled — never a code path.
enum Industry {
  EDUCATION
  CLINIC
  RESTAURANT
  RETAIL
  FITNESS
  PROFESSIONAL
  GENERIC
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  industry  Industry @default(GENERIC)
  /// shadcn token overrides. `themePreset` names one of the built-in palettes;
  /// `themeTokens` holds a pasted tweakcn export and wins over it when present.
  themePreset String @default("default")
  themeTokens Json?
  /// The centre's mark. Null is a supported state, not a missing value: a
  /// monogram is drawn from the name instead, so a tenant created with a name
  /// and nothing else still looks deliberate. See packages/contracts/src/brand.ts.
  logoUrl   String?
  /// One line under the name, on the landing page and in the app shell.
  tagline   String?
  /// URL-safe handle, unique across the platform. Stable once issued — the
  /// superadmin can rename an org's display name without breaking anything.
  slug      String   @unique
  timezone  String   @default("Asia/Dubai")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  settings Setting?
  site     Site?

  @@index([isActive])
}

/// The centre's public landing page.
///
/// One per org, created with the org. `template` names a layout and the theme
/// supplies the colour, which is why content is stored template-agnostically —
/// switching layout must not lose anything anyone wrote. See
/// packages/contracts/src/sites.ts for the content shape.
model Site {
  id          String  @id @default(cuid())
  /// Not defaulted like the other tenant models: a Site is only ever created
  /// alongside its org, by hand, the way Setting is.
  orgId       String  @unique
  template    String  @default("classic")
  /// SiteStyle: surface, display face, corner radius, density. Orthogonal to
  /// `template` on purpose — 4 layouts × 108 treatments × 8 themes, none of
  /// which needs a template change. Null falls back to the vertical's default.
  style       Json?
  /// Unpublishing serves a 404 rather than hiding sections — a draft landing
  /// page that is still reachable is worse than no landing page.
  isPublished Boolean @default(true)
  /// SiteContent: hero, highlights, services, proof, faq, contact, order.
  content     Json
  metaTitle       String?
  metaDescription String?
  /// Where a captured lead is queued. Null means capture-only: the contact is
  /// created but nobody is dialled, which is the right default for a live client
  /// and the wrong one for a demo, so the editor makes it a visible choice.
  leadCampaignId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads SiteLead[]
}

/// A callback request from a landing page.
///
/// Kept as its own row rather than only becoming a Contact: the contact record
/// is what the dialler needs, but this is the evidence of consent — what was
/// typed, from which page, when — and a contact that has been edited since no
/// longer answers "what did they actually agree to".
model SiteLead {
  id        String  @id @default(cuid())
  orgId     String  @default("")
  siteId    String
  name      String
  phoneE164 String
  email     String?
  message   String?
  /// "hero" | "contact" — which form on the page produced it.
  source    String  @default("contact")
  /// The contact this became, so the dialler and the inbox can reach them.
  contactId String?
  /// Set when the lead was queued to a campaign rather than only captured.
  targetId  String?
  /// Kept for abuse triage, not analytics. A public form is a public form.
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

enum EvalReviewer {
  /// Scored by a model against the transcript, unattended.
  AUTO
  /// A person listened and scored it. Overrides an AUTO score on the same call.
  HUMAN
}

/* ========================= people & presence ============================= */

model User {
  id           String   @id @default(cuid())
  /// Null only for SUPERADMIN, which sits above every org.
  orgId        String?
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENT)
  location     Location
  timezone     String
  skills       Skill[]
  extension    String?
  /// The handset a telecaller's own calls are bridged to, E.164.
  ///
  /// Null is the normal state: an agent who works in the browser softphone
  /// never needs one. It is required only for the carrier bridge, where Twilio
  /// rings this number first and connects the customer once it answers — so a
  /// missing one is a clear refusal at dial time, not a silent no-op.
  phoneE164    String?
  avatarColor  String   @default("#2563eb")
  /// Bitrix24 user id, so calls land on the right CRM user's timeline.
  bitrixUserId String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org              Organization?     @relation(fields: [orgId], references: [id])
  presence         AgentState?
  stateEvents      AgentStateEvent[]
  callParticipants CallParticipant[]
  conversations    Conversation[]
  refreshTokens    RefreshToken[]
  queues           QueueMembership[]
  messages         Message[]
  auditLogs        AuditLog[]

  /// Email stays globally unique: sign-in takes an address and nothing else, so
  /// two orgs sharing one would make the login ambiguous. Extensions are only
  /// unique *within* an org — two centres both wanting ext 101 is normal.
  @@unique([orgId, extension])
  @@index([role, isActive])
  @@index([orgId, role, isActive])
  callEvals CallEval[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 of the token. Never store the token itself.
  tokenHash String   @unique
  /// Set when rotated. A second use of a revoked token means theft → revoke all.
  revokedAt DateTime?
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// Current state — one row per agent, cheap to read for the live board.
model AgentState {
  userId        String      @id
  orgId         String      @default("")
  status        AgentStatus @default(OFFLINE)
  since         DateTime    @default(now())
  reason        String?
  currentCallId String?
  /// Last websocket heartbeat; a stale value flips the agent OFFLINE.
  lastSeenAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([orgId, status])
}

/// Append-only. Every transition. Source of truth for occupancy & adherence.
model AgentStateEvent {
  id       BigInt      @id @default(autoincrement())
  orgId    String      @default("")
  userId   String
  from     AgentStatus?
  to       AgentStatus
  at       DateTime    @default(now())
  reason   String?
  /// Duration spent in the *previous* state, denormalised so reports don't
  /// need window functions over the whole table.
  prevMs   Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([at])
}

/* ================================ contacts =============================== */

model Contact {
  id             String    @id @default(cuid())
  orgId          String    @default("")
  phoneE164      String?
  name           String?
  email          String?
  courseInterest String?
  /// "lead" | "contact" — Bitrix distinguishes them and the API paths differ.
  bitrixEntity   String?
  bitrixId       String?
  bitrixSyncedAt DateTime?
  /// Set when someone asks not to be called again. The dialer refuses these
  /// before it looks at anything else — an opt-out that can be overridden by a
  /// campaign setting is not an opt-out.
  doNotCall      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversations Conversation[]
  campaignTargets CampaignTarget[]

  /// The same caller may exist in two centres — a shared number is only a
  /// duplicate within one org.
  @@unique([orgId, phoneE164])
  @@index([bitrixEntity, bitrixId])
  @@index([name])
}

/* ============================== conversations ============================ */

model Conversation {
  id          String             @id @default(cuid())
  orgId       String             @default("")
  channel     Channel
  direction   Direction          @default(INBOUND)
  status      ConversationStatus @default(ACTIVE)
  contactId   String?
  queueId     String?
  /// Human agent who ultimately handled it. Null when AI-contained.
  handledById String?
  startedAt   DateTime           @default(now())
  endedAt     DateTime?
  disposition Disposition?
  notes       String?
  tags        String[]
  /// True when no human ever joined — the containment KPI.
  aiContained Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  contact   Contact?  @relation(fields: [contactId], references: [id])
  queue     Queue?    @relation(fields: [queueId], references: [id])
  handledBy User?     @relation(fields: [handledById], references: [id])
  call      Call?
  messages  Message[]
  aiSession AiSession?

  @@index([channel, startedAt(sort: Desc)])
  @@index([status, channel])
  @@index([startedAt(sort: Desc)])
  @@index([handledById, startedAt(sort: Desc)])
  @@index([queueId, startedAt(sort: Desc)])
  @@index([orgId, startedAt(sort: Desc)])
  @@index([orgId, status, channel])
  callEval  CallEval?
}

model Call {
  id             String    @id @default(cuid())
  orgId          String    @default("")
  conversationId String    @unique
  /// Provider's id. Unique → redelivered carrier events are no-ops.
  providerCallId String    @unique
  driver         String
  mediaSessionId String?
  fromNumber     String
  toNumber       String
  state          CallState @default(RINGING)

  ringingAt       DateTime  @default(now())
  aiAnsweredAt    DateTime?
  escalatedAt     DateTime?
  queuedAt        DateTime?
  agentRingingAt  DateTime?
  agentAnsweredAt DateTime?
  wrapupStartedAt DateTime?
  endedAt         DateTime?

  hangupCause      HangupCause?
  escalationReason EscalationReason?
  onHold           Boolean           @default(false)

  /// Derived once at completion so analytics never recompute from timestamps.
  queueWaitMs Int?
  aiTalkMs    Int?
  agentTalkMs Int?
  holdMs      Int?
  wrapMs      Int?
  totalMs     Int?

  /// How many agents were offered this call before someone took it.
  offerCount Int @default(0)

  /// Set when a telecaller dialled this call by hand rather than the AI or the
  /// campaign dialer placing it. Drives the answer path (bridge the agent, no AI
  /// leg) and makes "calls placed by X" answerable in reporting.
  placedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participants CallParticipant[]
  recording    Recording?
  segments     TranscriptSegment[]

  @@index([state, ringingAt(sort: Desc)])
  @@index([ringingAt(sort: Desc)])
  @@index([orgId, state, ringingAt(sort: Desc)])
}

/// One call, multiple participants over time. Models the handoff explicitly.
model CallParticipant {
  id       String          @id @default(cuid())
  orgId    String          @default("")
  callId   String
  kind     ParticipantKind
  userId   String?
  joinedAt DateTime        @default(now())
  leftAt   DateTime?

  call Call  @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([callId])
  @@index([userId, joinedAt(sort: Desc)])
}

/// Unified turn record — an AI voice turn and a WhatsApp message share a shape.
model Message {
  id             String      @id @default(cuid())
  orgId          String      @default("")
  conversationId String
  role           MessageRole
  text           String
  /// Set for voice turns; aligns the transcript to the waveform playhead.
  audioOffsetMs  Int?
  confidence     Float?
  authorId       String?
  /// Provider id for outbound chat, so delivery receipts can be matched.
  providerMessageId String? @unique
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id])

  @@index([conversationId, createdAt])
}

/* ============================== media & AI =============================== */

model Recording {
  id         String    @id @default(cuid())
  orgId      String    @default("")
  callId     String    @unique
  storageKey String
  durationMs Int
  mimeType   String    @default("audio/webm")
  sizeBytes  Int
  /// Retention sweep deletes rows past this.
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model TranscriptSegment {
  id         BigInt          @id @default(autoincrement())
  orgId      String          @default("")
  callId     String
  speaker    ParticipantKind
  startMs    Int
  endMs      Int
  text       String
  confidence Float?

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, startMs])
}

/// How good the assistant's handling of one call was.
///
/// Separate from AiSession rather than more columns on it, because a score is
/// a judgement ABOUT a session made later and possibly more than once — an
/// automatic pass on every call, then a human overriding a few. Folding it in
/// would mean a session row that changes meaning depending on who last touched
/// it, and no way to say "the model scored this 82 and a supervisor disagreed".
model CallEval {
  id             String @id @default(cuid())
  orgId          String @default("")
  conversationId String @unique

  /// 0-100. Derived from the four dimensions, stored rather than computed so a
  /// change to the weighting does not silently rewrite history.
  score Int

  /// Was what it said actually right?
  accuracy Int
  /// Did it stay inside what it is allowed to say — no invented prices, no
  /// promises the centre has not made? The dimension this product exists for.
  policy Int
  /// Did it hand over at the right moment: not clinging to a call it could not
  /// finish, not escalating one it could have.
  escalation Int
  /// Did it sound like this centre.
  tone Int

  /// One sentence a supervisor can read. Not a transcript summary — a verdict.
  note       String?
  reviewer   EvalReviewer @default(AUTO)
  reviewedById String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation(fields: [reviewedById], references: [id])

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, score])
}

model AiSession {
  id             String @id @default(cuid())
  orgId          String @default("")
  conversationId String @unique
  aiAgentId      String

  /// Audit which drivers actually ran — matters when comparing mock vs real.
  driverStt String
  driverLlm String
  driverTts String

  turns            Int               @default(0)
  escalated        Boolean           @default(false)
  escalationReason EscalationReason?
  escalationDetail String?
  detectedIntent   String?
  courseOfInterest String?
  sentiment        Float?
  summary          String?
  avgLatencyMs     Int?
  costUsd          Decimal?          @db.Decimal(10, 6)
  inputTokens      Int               @default(0)
  outputTokens     Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiAgent      AiAgent      @relation(fields: [aiAgentId], references: [id])

  @@index([aiAgentId, createdAt(sort: Desc)])
}

model AiAgent {
  id           String  @id @default(cuid())
  orgId        String  @default("")
  name         String
  greeting     String
  systemPrompt String
  voice        String  @default("en-GB")
  language     String  @default("en")
  /// EscalationRules, validated by zod on write.
  escalationRules Json
  defaultQueueId  String?
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions AiSession[]
  numbers  PhoneNumber[]
  queue    Queue?        @relation(fields: [defaultQueueId], references: [id])
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  orgId     String   @default("")
  title     String
  category  Skill    @default(GENERAL)
  source    String   @default("manual")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@index([category])
}

model KnowledgeChunk {
  id      String @id @default(cuid())
  orgId   String @default("")
  docId   String
  ordinal Int
  content String
  /// Bag-of-words vector over a fixed vocabulary. Float[] not pgvector — see
  /// the header note. Cosine is computed in-process.
  embedding Float[]
  /// Lowercased keyword set, so the scripted brain can do exact-term boosting.
  keywords  String[]

  doc KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, ordinal])
  @@index([docId])
}

/* ================================ routing ================================ */

model Queue {
  id            String          @id @default(cuid())
  orgId         String          @default("")
  name          String
  requiredSkill Skill
  slaSeconds    Int             @default(20)
  strategy      RoutingStrategy @default(LONGEST_IDLE)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  memberships   QueueMembership[]
  conversations Conversation[]
  numbers       PhoneNumber[]
  aiAgents      AiAgent[]

  /// "Admissions" is a queue name every centre will want.
  @@unique([orgId, name])
}

model QueueMembership {
  orgId    String @default("")
  queueId  String
  userId   String
  /// Higher wins under SKILL_WEIGHTED routing.
  priority Int    @default(1)

  queue Queue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([queueId, userId])
  @@index([userId])
}

/* ============================== outbound ================================= */

/// An outbound calling campaign: who to call, what the AI opens with, and the
/// pacing that keeps it defensible.
///
/// Pacing and the call window are on the campaign rather than global settings
/// because two campaigns in the same centre legitimately differ — a "your
/// certificate is ready" list can run all day at low concurrency, while a
/// time-sensitive reminder wants a tighter window and more lines.
model Campaign {
  id        String         @id @default(cuid())
  orgId     String         @default("")
  name      String
  status    CampaignStatus @default(DRAFT)

  /// What the assistant says first. The AI agent supplies the rest of its
  /// behaviour; only the opener is campaign-specific.
  opener    String
  /// Why this centre is allowed to call these people. Free text, required, and
  /// recorded on every call — under UAE marketing rules "we had the number" is
  /// not a basis, and a dialer that does not make you write it down invites
  /// exactly that.
  consentBasis String

  aiAgentId      String
  /// Where an escalated outbound call goes.
  queueId        String?
  /// The DID to present. Must belong to this centre.
  fromNumberId   String?

  /// Simultaneous live calls this campaign may hold.
  maxConcurrent  Int @default(2)
  /// Local-time window, inclusive start, exclusive end, in the org's timezone.
  windowStartHour Int @default(9)
  windowEndHour   Int @default(18)
  /// 1 = Monday … 7 = Sunday. Empty means every day.
  daysOfWeek     Int[]

  maxAttempts        Int @default(2)
  retryAfterMinutes  Int @default(120)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  targets CampaignTarget[]

  @@index([orgId, status])
}

/// One person on a campaign's list, and the outcome of calling them.
model CampaignTarget {
  id         String       @id @default(cuid())
  orgId      String       @default("")
  campaignId String
  contactId  String
  status     TargetStatus @default(PENDING)

  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  /// When a retry becomes eligible. The dialer never picks a target before this.
  nextAttemptAt  DateTime?
  /// The conversation the successful attempt produced.
  conversationId String?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id])

  /// One entry per person per campaign — re-importing a list must not double-call.
  @@unique([campaignId, contactId])
  /// The dialer's hot query: next eligible target for a campaign.
  @@index([campaignId, status, nextAttemptAt])
  @@index([orgId, status])
}

/* =========================== number inventory ============================ */

/// Mocked DID stock in v1 — demonstrates virtual numbers replacing SIM cards.
/// Real provisioning needs a TDRA-licensed UAE carrier.
model PhoneNumber {
  id              String       @id @default(cuid())
  orgId           String       @default("")
  /// Globally unique: a real DID is assignable to exactly one centre, and two
  /// orgs claiming the same number would make inbound routing ambiguous.
  e164            String       @unique
  label           String?
  country         String       @default("AE")
  region          String?
  provider        String       @default("mock")
  monthlyCostUsd  Decimal      @db.Decimal(8, 2) @default(0)
  status          NumberStatus @default(AVAILABLE)
  inboundQueueId  String?
  aiAgentId       String?
  recordingEnabled Boolean     @default(true)
  purchasedAt     DateTime?
  releasedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  inboundQueue Queue?   @relation(fields: [inboundQueueId], references: [id])
  aiAgent      AiAgent? @relation(fields: [aiAgentId], references: [id])

  @@index([status])
}

/* ========================= integration plumbing ========================== */

/// Transactional outbox. Domain writes and event publication commit together,
/// then the worker drains. No dual-write bugs, no lost CRM pushes.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  orgId       String    @default("")
  aggregate   String
  aggregateId String
  type        String
  payload     Json
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  /// Exponential backoff target; the drainer skips rows until this passes.
  nextAttemptAt DateTime @default(now())
  createdAt   DateTime  @default(now())

  @@index([publishedAt, nextAttemptAt])
  @@index([aggregate, aggregateId])
}

model CrmSyncLog {
  id         BigInt        @id @default(autoincrement())
  orgId      String        @default("")
  direction  SyncDirection
  method     String
  entityType String
  localId    String?
  bitrixId   String?
  status     SyncStatus    @default(PENDING)
  request    Json
  response   Json?
  error      String?
  attempts   Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, id])
  @@index([localId])
  @@index([createdAt(sort: Desc)])
}

/// Dedupe table for inbound provider webhooks (Bitrix, Meta). Unique event id
/// means a retried delivery can't double-process.
model ProcessedWebhook {
  id          String   @id
  source      String
  processedAt DateTime @default(now())

  @@index([source, processedAt])
}

/* =============================== analytics =============================== */

/// Pre-aggregated so /analytics never scans Call. Rolled up incrementally on
/// call completion and reconciled nightly.
model CallMetricsDaily {
  /// Part of the primary key, not just a filter: the org-wide rollup rows use
  /// ""/"" for queueId/agentId, so without orgId two centres would collide on
  /// the same day and silently sum each other's calls.
  orgId   String   @default("")
  day     DateTime
  queueId String   @default("")
  agentId String   @default("")

  calls             Int    @default(0)
  aiContained       Int    @default(0)
  escalated         Int    @default(0)
  abandoned         Int    @default(0)
  answeredWithinSla Int    @default(0)
  talkMsTotal       BigInt @default(0)
  handleMsTotal     BigInt @default(0)
  queueWaitMsTotal  BigInt @default(0)
  wrapMsTotal       BigInt @default(0)
  answeredCount     Int    @default(0)

  @@id([orgId, day, queueId, agentId])
  @@index([day])
  @@index([orgId, day])
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  /// "" for platform-level actions (superadmin creating an org), since those
  /// belong to no tenant.
  orgId    String   @default("")
  actorId  String?
  action   String
  target   String
  metadata Json?
  ip       String?
  at       DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([at(sort: Desc)])
  @@index([actorId, at(sort: Desc)])
  @@index([orgId, at(sort: Desc)])
}

/// One row per organisation. Was a literal singleton before tenancy; the shape
/// is otherwise unchanged, so an admin's settings page still edits exactly the
/// knobs it always did — just their own centre's.
model Setting {
  id                    String   @id @default(cuid())
  orgId                 String   @unique
  instituteName         String   @default("FIT Institute")
  instituteTimezone     String   @default("Asia/Dubai")
  recordingConsentText  String   @default("This call may be recorded for quality and training purposes.")
  recordingConsentOn    Boolean  @default(true)
  recordingRetentionDays Int     @default(365)
  wrapupSeconds         Int      @default(20)
  agentRingTimeoutSec   Int      @default(20)
  /// Used for the cost-saving figure on the analytics page.
  agentHourlyCostUsd    Decimal  @db.Decimal(8, 2) @default(12.00)
  bitrixPortalUrl       String?

  /// Per-centre CRM. Empty means "inherit the deployment's CRM_DRIVER", which is
  /// how the seeded tenant keeps working without being reconfigured.
  crmProvider           String   @default("")
  /// Non-secret fields for whichever provider is selected (Zoho region and
  /// client id, the webhook host). Shown on the settings page and used for
  /// deep links. Shapeless on purpose: five providers with different fields
  /// would otherwise mean five sets of mostly-null columns.
  crmPublic             Json?
  /// The provider's secrets as one AES-256-GCM blob — see
  /// apps/api/src/shared/secret-box.ts. A leaked row must not be a working
  /// credential, and adding a sixth provider must not need a migration.
  crmSecretsEnc         String?
  crmUpdatedAt          DateTime?

  updatedAt             DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}
