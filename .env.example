# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3101
WEB_ORIGIN=http://localhost:3200

# Embedded Postgres started by `pnpm services:up` (real PG 17, repo-local)
DATABASE_URL="postgresql://fitai:fitai@127.0.0.1:55432/fitai?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Dev-only values. Generate real ones with: openssl rand -hex 48
JWT_ACCESS_SECRET="dev-access-secret-change-me-0000000000000000000000"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-000000000000000000000"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── Swappable drivers ────────────────────────────────────────────────────────
# telephony: simulated | browser | livekit
#   simulated → deterministic scripted FIT calls, no audio, zero cost
#   browser   → real mic/speaker via Web Speech + WebRTC peer for the human leg
#   livekit   → real SIP trunk (not implemented; see NOT-IMPLEMENTED.md)
TELEPHONY_DRIVER=simulated

# messaging (WhatsApp): mock | meta
#   mock → simulated WhatsApp inbound/outbound, full inbox + AI + handoff
#   meta → Meta Cloud API (not implemented; needs business verification)
MESSAGING_DRIVER=mock

# stt: web-speech | deepgram        tts: web-speech | elevenlabs
STT_DRIVER=web-speech
TTS_DRIVER=web-speech

# ── ElevenLabs (real telephony + voice) ──────────────────────────────────────
# Set TELEPHONY_DRIVER=elevenlabs to route real phone calls through ElevenLabs
# Agents while OUR api stays the brain (see the custom-LLM bridge in README).
#
# ElevenLabs must be able to reach us, so PUBLIC_BASE_URL has to be a public
# HTTPS origin — a tunnel (`cloudflared tunnel --url http://localhost:3101`) or a
# deploy. localhost is not reachable from their infrastructure.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Generate both: openssl rand -hex 32
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_BRIDGE_SECRET=
# Voice/model for the STANDALONE TTS driver only (TTS_DRIVER=elevenlabs).
# The Agent's own voice is NOT set from here — configure that in the ElevenLabs
# dashboard, so there is one place to change it and no drift from what the
# caller actually hears.
# Must be a *premade* voice on the free tier: library/professional voices return
# 402 "Free users cannot use library voices via the API". Default is Jessica.
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Where an escalated call's audio is transferred. Leave blank until FIT have a
# licensed UAE trunk: escalation still fires the screen-pop and CRM sync, the
# caller is just told an advisor will pick up rather than being moved.
ELEVENLABS_TRANSFER_NUMBER=
# ── Twilio (real phone calls) ────────────────────────────────────────────────
# Set TELEPHONY_DRIVER=twilio to make the telecaller's Dial button ring a real
# phone. The bridge rings the AGENT first and connects the customer only once
# the agent answers, so nobody's phone rings without a human already on the line.
#
# From the Twilio console (console.twilio.com):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A voice-capable number on that account. Both legs are presented as this.
TWILIO_NUMBER=
# Optional. Rung when the signed-in telecaller has no phone number set in their
# profile — convenient for a one-handset demo, wrong for more than one agent.
TWILIO_AGENT_FALLBACK_NUMBER=
# Leave true. Only ever false to replay a captured webhook locally, where the
# URL differs from the one Twilio signed.
TWILIO_VERIFY_SIGNATURE=true
#
# Twilio must reach us for the TwiML bridge and the status callbacks, so
# PUBLIC_BASE_URL below has to be publicly routable. In development:
#   .data/bin/cloudflared tunnel --url http://localhost:3101
# then paste the printed https URL into PUBLIC_BASE_URL and restart the API.
#
# On a TRIAL account: verify the destination number in the console first
# (Phone Numbers -> Verified Caller IDs) or the call is rejected, and expect a
# recorded trial notice before the two legs connect.

PUBLIC_BASE_URL=
# Browser calls need only the key + PUBLIC_BASE_URL. A dialable phone number
# additionally needs Twilio or a SIP trunk; outbound to a real phone is impossible
# without one — ElevenLabs does not sell numbers.

# llm: scripted | claude | ollama
#   scripted → deterministic KB retrieval, zero cost, no hallucination
LLM_DRIVER=scripted
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# crm: mock | bitrix
CRM_DRIVER=mock
# Bitrix24 inbound webhook, e.g. https://fitiedu.bitrix24.ae/rest/1/xxxxxxxxxxxx/
# Encrypts tenant-supplied CRM credentials at rest. Any long random string;
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required before a centre can save Bitrix24 or Zoho credentials in Settings.
CRM_SECRET_KEY=

# --- Dograh (self-hosted voice agents) -------------------------------------
# A centre points its public landing page at one Dograh workflow, from the
# Website page. Both of these are optional and are only the *deployment-wide*
# default: a centre that saves its own host and key in the editor uses those,
# encrypted at rest with CRM_SECRET_KEY above.
#
# Setting DOGRAH_API_KEY here lights up every seeded tenant at once, which is
# right for a demo and wrong for a real client — one key would then be shared
# by every centre on the deployment.
DOGRAH_BASE_URL=
DOGRAH_API_KEY=

# --- Website enrichment: who writes the landing-page copy -------------------
# auto | anthropic | groq | none
#   auto  — Groq if its key and model are set, else Anthropic, else `none`
#   none  — no model: the page is built from the site's own title and headings,
#           and the agent brief is the scraped text handed straight to Dograh,
#           whose own generator reads natural language. Onboarding still works.
ENRICH_LLM=auto
# Groq, via its OpenAI-compatible endpoint. GROQ_MODEL has no default on
# purpose — Groq retires and renames hosted models, and a baked-in id would
# surface as "enrichment failed" long after anyone remembers why.
# Pick one from https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=

BITRIX_WEBHOOK_URL=
# Shared secret we require on Bitrix -> us outbound webhooks
BITRIX_INBOUND_TOKEN=

# storage: local | r2
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Contact centre behaviour ─────────────────────────────────────────────────
INSTITUTE_TIMEZONE=Asia/Dubai
RECORDING_RETENTION_DAYS=365
RECORDING_CONSENT_ENABLED=true
WRAPUP_SECONDS=20
AGENT_RING_TIMEOUT_SECONDS=20
DEFAULT_SLA_SECONDS=20

# Auto-generate background traffic so the dashboard always looks alive in demos
SIMULATOR_AUTOPILOT=false
SIMULATOR_AUTOPILOT_INTERVAL_MS=45000

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3101
NEXT_PUBLIC_WS_URL=http://localhost:3101
